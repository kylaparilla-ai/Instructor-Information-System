@model InstructorInformationSystem.Models.Instructor
@{
    ViewData["Title"] = "Delete Instructor";
}

<div class="auth-container" style="max-width: 600px;">
    <h2>Delete Confirmation</h2>
    <p class="text-danger">Are you sure you want to delete this instructor?</p>
    <hr />
    <p><strong>Full Name:</strong> @Model.FullName</p>
    <p><strong>Designation:</strong> @Model.Designation</p>
    <p><strong>Majorship:</strong> @Model.Majorship</p>
    <br />
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="InstructorID" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>