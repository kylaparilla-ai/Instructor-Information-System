@{
    Layout = null;
    ViewData["Title"] = "Register - InstructorInformationSystem";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                padding: 24px 16px;
                min-height: 100vh;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background: linear-gradient(rgba(10, 30, 20, 0.72), rgba(10, 30, 20, 0.86)), url('https://images.unsplash.com/photo-1518531933037-91b2f5f229cc?auto=format&fit=crop&w=1920&q=80') no-repeat center center fixed;
                background-size: cover;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .card-box {
                position: relative;
                background: #ffffff;
                width: 100%;
                max-width: 420px;
                border-radius: 32px;
                padding: 46px 32px 34px;
                box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
                text-align: center;
                overflow: hidden;
            }

                .card-box::before {
                    content: '\f06c';
                    font-family: 'Font Awesome 6 Free';
                    font-weight: 900;
                    position: absolute;
                    top: -14px;
                    right: -12px;
                    font-size: 76px;
                    color: rgba(63, 114, 81, 0.14);
                    transform: rotate(28deg);
                    pointer-events: none;
                }

            .back-circle {
                position: absolute;
                top: 20px;
                left: 20px;
                width: 36px;
                height: 36px;
                border-radius: 50%;
                background: #eef3ef;
                color: #2d5a3f;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                text-decoration: none;
                font-size: 14px;
            }

            h1 {
                color: #2d5a3f;
                font-size: 30px;
                font-weight: 700;
                margin: 6px 0 4px;
                position: relative;
                z-index: 2;
            }

            .subtitle {
                color: #9aa7a0;
                font-size: 13.5px;
                margin: 0 0 26px;
                position: relative;
                z-index: 2;
            }

            .input-pill {
                background: #e6eee8;
                border-radius: 14px;
                padding: 12px 16px;
                margin-bottom: 14px;
                display: flex;
                align-items: center;
                gap: 12px;
                position: relative;
                z-index: 2;
            }

                .input-pill:focus-within {
                    box-shadow: 0 0 0 2px #3f7251;
                }

                .input-pill i.icon-left {
                    color: #3f7251;
                    font-size: 15px;
                    width: 16px;
                }

                .input-pill input {
                    border: none;
                    background: transparent;
                    width: 100%;
                    color: #1f3b2b;
                    font-size: 14px;
                    outline: none;
                }

            .btn-green {
                width: 100%;
                background: #3f7251;
                color: #ffffff;
                border: none;
                border-radius: 25px;
                padding: 13px;
                margin-top: 8px;
                font-size: 15.5px;
                font-weight: 600;
                cursor: pointer;
                box-shadow: 0 8px 18px rgba(63, 114, 81, 0.25);
                position: relative;
                z-index: 2;
            }

                .btn-green:hover {
                    background: #2f593e;
                }

            .bottom-link {
                margin-top: 20px;
                font-size: 12.5px;
                color: #9aa7a0;
                position: relative;
                z-index: 2;
            }

                .bottom-link a {
                    color: #2d5a3f;
                    font-weight: 700;
                    text-decoration: underline;
                }

            .err-box {
                background: #fde8e8;
                color: #b02a37;
                border-radius: 12px;
                padding: 9px 12px;
                font-size: 12.5px;
                margin-bottom: 14px;
                text-align: left;
                position: relative;
                z-index: 2;
            }
    </style>
</head>
<body>
    <div class="card-box">
        <a asp-controller="Account" asp-action="Login" class="back-circle" title="Back to Login">
            <i class="fa-solid fa-chevron-left"></i>
        </a>

        <h1>Register</h1>
        <p class="subtitle">Create your new account</p>

        @if (ViewBag.Error != null)
        {
            <div class="err-box">@ViewBag.Error</div>
        }

        <form asp-controller="Account" asp-action="Register" method="post">
            <div class="input-pill">
                <i class="fa-solid fa-user icon-left"></i>
                <input type="text" name="FullName" placeholder="Full Name" required />
            </div>

            <div class="input-pill">
                <i class="fa-solid fa-envelope icon-left"></i>
                <input type="email" name="Email" placeholder="Email Address" required />
            </div>

            <div class="input-pill">
                <i class="fa-solid fa-lock icon-left"></i>
                <input type="password" id="regPassword" name="Password" placeholder="Password" required />
                <i class="fa-solid fa-eye" id="toggleRegPassword" style="color:#5c7366; cursor:pointer;"></i>
            </div>

            <button type="submit" class="btn-green">Register</button>
        </form>

        <div class="bottom-link">
            Already have an account? <a asp-controller="Account" asp-action="Login">Login</a>
        </div>
    </div>

    <script>
            document.getElementById('toggleRegPassword').addEventListener('click', function () {
                const inp = document.getElementById('regPassword');
                inp.type = inp.type === 'password' ? 'text' : 'password';
                this.classList.toggle('fa-eye');
                this.classList.toggle('fa-eye-slash');
            });
    </script>
</body>
</html>